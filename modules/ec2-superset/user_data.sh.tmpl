#!/bin/bash
set -euo pipefail

# Atualiza e instala Docker
if command -v dnf >/dev/null 2>&1; then
  dnf update -y
  dnf install -y docker python3-pip
else
  yum update -y
  amazon-linux-extras install docker -y || yum install -y docker
  yum install -y python3-pip
fi

systemctl enable --now docker
usermod -aG docker ec2-user || true

# docker-compose
pip3 install --break-system-packages docker-compose || pip3 install docker-compose

mkdir -p /opt/superset
cat > /opt/superset/.env <<EOF
SUPERSET_SECRET_KEY=${SUPERSET_SECRET_KEY}
ADMIN_USERNAME=${ADMIN_USERNAME}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_EMAIL=${ADMIN_EMAIL}
SUPERSET_DB=postgresql+psycopg2://superset:superset@db:5432/superset
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
EOF

cat > /opt/superset/docker-compose.yml <<'YML'
version: "3.9"
services:
  redis:
    image: redis:7
    restart: unless-stopped

  db:
    image: postgres:15
    environment:
      POSTGRES_USER: superset
      POSTGRES_PASSWORD: superset
      POSTGRES_DB: superset
    volumes:
      - db_data:/var/lib/postgresql/data
    restart: unless-stopped

  superset:
    image: apache/superset:latest
    depends_on:
      - db
      - redis
    ports:
      - "8088:8088"
    environment:
      - SUPERSET_SECRET_KEY=${SUPERSET_SECRET_KEY}
      - SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py
      - SQLALCHEMY_DATABASE_URI=${SUPERSET_DB}
      - REDIS_HOST=${REDIS_HOST}
      - REDIS_PORT=${REDIS_PORT}
    volumes:
      - superset_home:/app/superset_home
    restart: unless-stopped
    command: ["/bin/bash", "-c", "\
      if [ ! -f /app/superset_home/INITIALIZED ]; then \
        superset fab create-admin \
          --username \"${ADMIN_USERNAME}\" \
          --password \"${ADMIN_PASSWORD}\" \
          --firstname Admin --lastname User \
          --email \"${ADMIN_EMAIL}\" && \
        superset db upgrade && \
        superset init && \
        touch /app/superset_home/INITIALIZED; \
      fi; \
      /usr/bin/superset run -p 8088 --with-threads --reload --debugger\
    "]
volumes:
  db_data:
  superset_home:
YML

cd /opt/superset
/usr/local/bin/docker-compose --env-file .env up -d || docker-compose --env-file .env up -d

# Espera porta 8088
for i in {1..60}; do
  if ss -lnt | grep -q ":8088"; then echo "Superset ouvindo 8088"; break; fi
  sleep 2
done
